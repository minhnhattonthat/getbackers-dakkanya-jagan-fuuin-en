[
 {
  "id": "F08E88:1",
  "kind": "msg",
  "speaker": "窪田",
  "jp": "では、失礼致します",
  "en": "",
  "status": ""
 },
 {
  "id": "F08ED4:1",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ま、今日は前祝いってコトで\nパーッといくか！",
  "en": "",
  "status": ""
 },
 {
  "id": "F08ED4:3",
  "kind": "msg",
  "speaker": "ヘヴン",
  "jp": "ちょっとアンタたち…\n依頼料はまだ入ってないんでしょ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F08ED4:5",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ンなモン、\n手に入ったも同然じゃねぇかよ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F08ED4:6",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ブハハハハッ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F08ED4:8",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "ねえ、蛮ちゃん…",
  "en": "",
  "status": ""
 },
 {
  "id": "F08ED4:9",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "清十郎さん、\nちゃんと記憶を奪り還せるのかな?",
  "en": "",
  "status": ""
 },
 {
  "id": "F08ED4:11",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "奪り還せるさ…大切な記憶ってのは\nそう簡単に消えるモンでもねぇしな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F08ED4:13",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "だよね！",
  "en": "",
  "status": ""
 },
 {
  "id": "F08ED4:14",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "さーて、\n前祝いにじゃんじゃん食べるぞー！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F08ED4:16",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "腹ごしらえが終ったら\nロフト付きアパートでも見にいくか！",
  "en": "",
  "status": ""
 },
 {
  "id": "F08ED4:18",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "いいねー！　ようやくオレらも\nまともな生活できそうだね！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F092D8:1",
  "kind": "msg",
  "speaker": "杏",
  "jp": "あらら…まだお金入ってないのに\nあんなにはしゃいでいいんスかねー?",
  "en": "",
  "status": ""
 },
 {
  "id": "F092D8:2",
  "kind": "msg",
  "speaker": "杏",
  "jp": "…あれ、なんか落ちてる?",
  "en": "",
  "status": ""
 },
 {
  "id": "F093CC:1",
  "kind": "msg",
  "speaker": "杏",
  "jp": "あれ?　これって蛮さんたちが奪還した\n日記の1ページじゃないッスか",
  "en": "",
  "status": ""
 },
 {
  "id": "F093CC:2",
  "kind": "msg",
  "speaker": "杏",
  "jp": "窪ちん、落としちゃったのかなー…",
  "en": "",
  "status": ""
 },
 {
  "id": "F093CC:3",
  "kind": "msg",
  "speaker": "杏",
  "jp": "ん?　なんか書いてあるッスね",
  "en": "",
  "status": ""
 },
 {
  "id": "F093CC:4",
  "kind": "msg",
  "speaker": "杏",
  "jp": "*月*日　今日、Kの計画を知る",
  "en": "",
  "status": ""
 },
 {
  "id": "F093CC:5",
  "kind": "msg",
  "speaker": "杏",
  "jp": "この計画だけは\nなんとしても止めなくては…",
  "en": "",
  "status": ""
 },
 {
  "id": "F093CC:7",
  "kind": "msg",
  "speaker": "杏",
  "jp": "K…",
  "en": "",
  "status": ""
 },
 {
  "id": "F093CC:8",
  "kind": "msg",
  "speaker": "杏",
  "jp": "これってもしかして………",
  "en": "",
  "status": ""
 },
 {
  "id": "F095A8:1",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "オメーがいても戻されたじゃねえかよ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F095A8:3",
  "kind": "msg",
  "speaker": "卑弥呼",
  "jp": "なによ！　アンタたちだけで\n抜けられるものなら抜けてみなさいよ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F095A8:5",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "まあまあ、二人とも…",
  "en": "",
  "status": ""
 },
 {
  "id": "F095A8:7",
  "kind": "msg",
  "speaker": "花月",
  "jp": "落ち着いて…",
  "en": "",
  "status": ""
 },
 {
  "id": "F096CC:1",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "ここで使えるんじゃない?\nカギ爪ロープ",
  "en": "",
  "status": ""
 },
 {
  "id": "F096CC:3",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "よし、使ってみるとするか…",
  "en": "",
  "status": ""
 },
 {
  "id": "F09768:1",
  "kind": "msg",
  "speaker": "卑弥呼",
  "jp": "どうしたのかしら、\n下が騒がしいわね…?",
  "en": "",
  "status": ""
 },
 {
  "id": "F09768:3",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "なンかあったんじゃねーか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F09768:4",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "絃巻き、探れるかよ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F09768:6",
  "kind": "msg",
  "speaker": "花月",
  "jp": "そうですね…\n下に絃を垂らせるようなところがあれば",
  "en": "",
  "status": ""
 },
 {
  "id": "F09768:8",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "穴が開いてればいいんだね?\n探してみよう！",
  "en": "",
  "status": ""
 },
 {
  "id": "F098D0:1",
  "kind": "msg",
  "speaker": "花月",
  "jp": "…どうも倉庫のカギがないことで\n騒いでいるみたいですよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F098D0:3",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "倉庫って、\nあの色んなモノが入ってるトコ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F098D0:5",
  "kind": "msg",
  "speaker": "花月",
  "jp": "ええ…一階の廊下の突き当たりに\n扉がありましたよね?",
  "en": "",
  "status": ""
 },
 {
  "id": "F098D0:6",
  "kind": "msg",
  "speaker": "花月",
  "jp": "そこから入るようです",
  "en": "",
  "status": ""
 },
 {
  "id": "F098D0:8",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "倉庫か…依頼品もそこにありそうだな?",
  "en": "",
  "status": ""
 },
 {
  "id": "F098D0:9",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "よし、俺たちも倉庫のカギを探すぞ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F098D0:11",
  "kind": "msg",
  "speaker": "花月",
  "jp": "カギはいつも一階左側の部屋の\nどこかに置いてあるとのことです",
  "en": "",
  "status": ""
 },
 {
  "id": "F098D0:12",
  "kind": "msg",
  "speaker": "花月",
  "jp": "その辺りを探ってみましょう！",
  "en": "",
  "status": ""
 },
 {
  "id": "F09B08:1",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "クソッ！　またかよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F09B08:3",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "ついつい走っちゃうんだよね…\nトホホ~",
