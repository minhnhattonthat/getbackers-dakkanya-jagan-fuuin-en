  "id": "F09EF0:6",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "そうだけどさ~",
  "en": "",
  "status": ""
 },
 {
  "id": "F09EF0:7",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "…あれ?\nこの壁、こっちからは回らないね",
