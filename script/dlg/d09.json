  "status": ""
 },
 {
  "id": "F0B394:21",
  "kind": "msg",
  "speaker": "窪田",
  "jp": "あなたのその言葉を聞いて\n思い出したのです",
  "en": "",
  "status": ""
 },
 {
  "id": "F0B394:23",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "その人って\nまだあの屋敷にいるんですか?",
