  "status": ""
 },
 {
  "id": "F0A0C8:4",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "つっても、\n暗号が分からねぇんじゃあな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F0A0C8:6",
  "kind": "msg",
  "speaker": "花月",
  "jp": "でしたら\n僕が敵から情報を聞き出してみましょう",
