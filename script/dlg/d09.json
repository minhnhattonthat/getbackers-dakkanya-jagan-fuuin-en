  "status": ""
 },
 {
  "id": "F0AD30:20",
  "kind": "msg",
  "speaker": "窪田",
  "jp": "左様でございます",
  "en": "",
  "status": ""
 },
 {
  "id": "F0AD30:21",
  "kind": "msg",
  "speaker": "窪田",
  "jp": "この招き猫を茶だんすの\n空いている場所に置きますと",
