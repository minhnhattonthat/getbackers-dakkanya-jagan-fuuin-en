  "status": ""
 },
 {
  "id": "F0B394:1",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "どうよ、清ジイ\n肖像画だ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F0B394:3",
  "kind": "msg",
  "speaker": "ヘヴン",
  "jp": "ちょっとォ…\nそれのどこがあたたかいものなワケ?",
