  "status": ""
 },
 {
  "id": "F0AD30:27",
  "kind": "msg",
  "speaker": "窪田",
  "jp": "私が探しているものは\nもっと平べったいものでございました",
  "en": "",
  "status": ""
 },
 {
  "id": "F0AD30:28",
  "kind": "msg",
  "speaker": "窪田",
  "jp": "それにあたたかいというのは\n気持ちの上でのことで、",
  "en": "",
  "status": ""
 },
 {
  "id": "F0AD30:29",
  "kind": "msg",
  "speaker": "窪田",
  "jp": "必ずしもそのものが\nあたたかいというわけではないようです",
  "en": "",
  "status": ""
 },
 {
  "id": "F0AD30:31",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "平べったい?",
