[
 {
  "id": "F8E448:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:またまたぁ~\nそないにテレんでもエエがな！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E4E8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:ムダに前向きだわね…アンタ",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E574:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:アンタ…最近ちょっと\nキャラがおかしくなってんじゃない?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E620:0",
  "kind": "msg",
  "speaker": "",
  "jp": "十兵衛:なっ…あれは修行のためだ！\nおかしくなどなってはおらんぞ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E6D0:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:あれが修行?\n…バッカじゃないの！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E768:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:フーン…\nアンタもあいつの取り巻きってワケね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E808:0",
  "kind": "msg",
  "speaker": "",
  "jp": "雨流:取り巻きなどではない！\n元親衛隊であるだけだ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E8A8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:だからそれが\n取り巻きっていうんじゃないの?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E948:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:洗脳されたあなたと\n一度戦ってみたかったですね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E9E8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:お望みであれば\nいつでも相手になりましょう…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8EA84:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:クス…\nでは楽しみにしておりますよ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8EB18:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:今回はあなたと\n戦うことはありませんでしたね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8EBB8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "士度:俺と戦うつもりなら\nいつでも来いよ…相手になってやらあ",
  "en": "",
  "status": ""
 },
 {
  "id": "F8EC60:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:頼もしいお言葉ですね、\nビーストマスター…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8ECFC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:(もしもシリーズ！\nドクター・ジャッカルとコント！！)",
  "en": "",
  "status": ""
 },
 {
  "id": "F8EDA4:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:…どうかしましたか、\n鮮血のジョーカー?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8EE40:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:ア、アカン！\n想像の中でスゴいことになっとったわ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8EEE4:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:以前より腕をあげたそうですね…\n飛針の十兵衛クン?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8EF88:0",
  "kind": "msg",
  "speaker": "",
  "jp": "十兵衛:試してみるか…\nドクター・ジャッカル?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F024:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:クス…\nいずれ試させていただきましょう",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F0BC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:あなたは\n村雨流の掌術を使うそうですね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F158:0",
  "kind": "msg",
  "speaker": "",
  "jp": "雨流:フ…責様がそのつもりなら、\n今すぐにでも相手になってやろう",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F204:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:ほう…面白いですね",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F284:0",
  "kind": "msg",
  "speaker": "",
  "jp": "弥勒:またあなたと一緒に仕事を\nすることになるとは思いませんでしたよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F334:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:次は仕事のパートナーではなく、\n敵として出会いたいものですね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F3E4:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:お笑いのことが\n少しは分かってきたの、士度?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F480:0",
  "kind": "msg",
  "speaker": "",
  "jp": "士度:よせよ、お前まで\nそんなこと聞くんじゃねーよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F520:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:いや…分かってきたなら\n十兵衛に教えてもらおうかと思ってね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F5CC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "士度:なるほどな…って、\nそんなモンは笑師にやってもらえ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F674:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:花月はん、風雅チームで\nトリオ漫才やったらどないでっか~?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F720:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:…それって僕がツッコミで?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F7A8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:当たり前やがな！\n他二人はどう考えてもボケボケやん",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F84C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:そ、そうかな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F8C8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:君の目が早く治るといいのにね、\n十兵衛",
  "en": "",
  "status": ""
 },
 {
  "id": "F8F960:0",
  "kind": "msg",
  "speaker": "",
  "jp": "十兵衛:案ずるな…目など\n見えずともお前を守ってみせるさ、花月",
  "en": "",
  "status": ""
 },
 {
  "id": "F8FA08:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:そうか…\nいつもすまないね、十兵衛",
  "en": "",
  "status": ""
 },
 {
  "id": "F8FA9C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:今回は君にも\n迷惑をかけてしまったね、俊樹",
  "en": "",
  "status": ""
 },
 {
  "id": "F8FB38:0",
  "kind": "msg",
  "speaker": "",
  "jp": "雨流:あの程度…迷惑のうちにも入らん\n俺と筧をもっと信頼してくれ",
  "en": "",
  "status": ""
 },
 {
  "id": "F8FBE4:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:…ありがとう、俊樹",
  "en": "",
  "status": ""
 },
 {
  "id": "F8FC64:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:いや~、今回も大活躍でしたな！\nうちらのお笑いコンビ！！",
  "en": "",
  "status": ""
 }
]
