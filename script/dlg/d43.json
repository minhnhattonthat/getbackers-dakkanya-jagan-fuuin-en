[
 {
  "id": "F8B168:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:だから、あれはワザと\n捕まったんだって言ったじゃない！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B214:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:やれやれ…ちったぁ\nしおらしくしてりゃいいものを…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B2B8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:いつか見返してやるんだから",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B344:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:今回は銀次のヤツが\nずいぶん世話ンなったみてぇだな?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B3E8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:ええ…ですが\nあなたへの興味は変わっていませんよ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B48C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:ま、こっちは\nいつでも相手になってやらあ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B524:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:邪眼封印…ですか\n切り札なのに封じられてしまうんですね",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B5CC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:るせェ！　それでもテメーの\nザリガニ釣りよかマシだってンだよ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B67C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:一度ならず二度までも\n我が流派を愚弄するとは…許せません！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B728:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:おっ、怒ったってか?\n女みてーなナリのくせしてまァ",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B7C8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:それは関係ないと思うのですが…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B854:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:ま、俺は\nいつでも相手になってやンぜ",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B8E8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "士度:あのバンとかいう\nヘビはテメーの親戚かよ、ヘビ野郎?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B990:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:そういうテメーは\n馬が親戚みてぇだがな?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8BA28:0",
  "kind": "msg",
  "speaker": "",
  "jp": "士度:ムダ口叩いてるヒマが\nあるんならとっとと借金返すんだな",
  "en": "",
  "status": ""
 },
 {
  "id": "F8BAD0:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:ムググググググ…\nヒモに言われたかねーんだよ、ヒモに！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8BB74:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮&士度:今日こそ決着つけてやらあ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8BC00:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:美堂はんは、\nホンマにヘビと親戚やったんやなあ",
  "en": "",
  "status": ""
 },
 {
  "id": "F8BCA0:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:あ?　フザけんなよ…\nって、なんのカッコだよ…そりゃあ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8BD48:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:なにってステージ衣装やんか~\n『きぐるミルミル』最高でっせ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8BDF8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:ま、俺様がリーダーの\n『THE☆カラマワリ』の方が上だがな",
  "en": "",
  "status": ""
 },
 {
  "id": "F8BEA0:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:ムム…お笑いの意地として\nアイドルには負けられへん！　勝負や！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8BF50:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:踊りの方もサマになってたぜ、\nサムライ君?　ブハハハハハハハ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C000:0",
  "kind": "msg",
  "speaker": "",
  "jp": "十兵衛:ウム…どうしても\nステップというものが踏めなくてな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C0A8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:ああ…頭も身体も硬そうだしな…\nもっと柔軟になれや、柔軟に！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C154:0",
  "kind": "msg",
  "speaker": "",
  "jp": "十兵衛:ぬう…ここはやはり\n酔を飲むしかないのだろうか…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C1F8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "雨流:美堂…どうしても\n貴様に聞いておきたいことがある",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C29C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:…あのことかよ?\n悪ィが俺様の口からは言えねえな",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C33C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "雨流:貴様…俺の意識がないことを\nいいことに色々としてくれたらしいな?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C3EC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:色々ってなんだ、色々って！\nだいたい誰から聞いた、そンなこと！?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C49C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:最近、一緒にする\n仕事が増えて楽しいよね~！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C53C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:あたしの方はなるべく\nアンタたちと組みたくないんだけど…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C5E8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:えっ…な、なんで！?\n一緒の方が楽しいのに~",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C688:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:アンタたちといると\nあたしまで金運悪くなりそうなのよね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C734:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:で、でもお金よりも\n大事なものがあるはずで~…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C7D4:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:なに言ってんの?\nお金の方が大事に決まってるじゃない",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C87C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:今回もなかなか\n楽しい仕事になりましたね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C918:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:なんでか一緒になることが\n多かったですしね…ハハ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8C9BC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:次に会う時はぜひとも\n手合わせ願いたいところですがね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8CA64:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:銀次さんと仕事をすると\n色々と楽しいことが多いですよ",
  "en": "",
  "status": ""
 }
]
