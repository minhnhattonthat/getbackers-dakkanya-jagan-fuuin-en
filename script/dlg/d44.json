[
 {
  "id": "F8CB08:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:ホント！　カヅっちゃんに\nそう言ってもらえるとうれしいよ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8CBB8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:ええ…なんというか\n予想外のことが沢山起こりますからね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8CC60:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:そうかもね~\nオレ自身はフツーなんだけどね！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8CD00:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:そうでしょうか?　僕の目には\n銀次さんも普通でないように映ります…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8CDB4:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:ひ、ひどいよ…カヅっちゃん",
  "en": "",
  "status": ""
 },
 {
  "id": "F8CE3C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "士度:ったく、今回も\n色々と厄介な仕事が多かったな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8CEDC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:だね！　ところでさ…その姿が\nマドカちゃんにバレなくて良かったね~",
  "en": "",
  "status": ""
 },
 {
  "id": "F8CF90:0",
  "kind": "msg",
  "speaker": "",
  "jp": "士度:全くだ…まさかまた\nキグルミを着ることになるとはな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D034:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:でもさ~、なにげに\n似合ってるよ！　良かったね、士度！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D0DC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "士度:良かねえよ！\nクソッ、二度と着ねえぞ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D178:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:いや~、今回も\nなかなかおいしい仕事でしたなぁ~",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D218:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:奪還勝負で\nお互いに歌を歌ったりしたもんね~",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D2B4:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:雷帝ンとこはアイドルやったな\nエエなあ、アイドル衣装ゆうのも",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D364:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:あっ、じゃあ交換しとく?\nオレ、キグルミも着てみたいし！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D410:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:さっすが雷帝や~！\nささ、気が変わらんうちに交換しとこか",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D4B8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:まさか十兵衛が\nアイドルになっちゃうなんてね~",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D558:0",
  "kind": "msg",
  "speaker": "",
  "jp": "十兵衛:柄にもないことを\nしてしまったか…?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D5F0:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:そんなことないんじゃない?\n未来人っぽくて似合ってたよ、衣装とか",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D6A0:0",
  "kind": "msg",
  "speaker": "",
  "jp": "十兵衛:未来人とは一体…！?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D724:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:雨流、\nキグルミデビューおめでとう！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D7BC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "雨流:キグルミを着たところで\nなにもうれしくはないがな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D860:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:え~、うれしくないの?\nでも似合ってたよヒツジのキグルミ",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D908:0",
  "kind": "msg",
  "speaker": "",
  "jp": "雨流:まだアイドルの方が\nマシだったかも知れんな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8D9A4:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:今回は色々と\nお世話になっちゃったね~、雪彦君には",
  "en": "",
  "status": ""
 },
 {
  "id": "F8DA48:0",
  "kind": "msg",
  "speaker": "",
  "jp": "弥勒:別にいいんだよ\nなんだかほっとけないしね…君のことは",
  "en": "",
  "status": ""
 },
 {
  "id": "F8DAEC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:最近、アンタとは\n別々の仕事が多いわね…ジャッカル",
  "en": "",
  "status": ""
 },
 {
  "id": "F8DB90:0",
  "kind": "msg",
  "speaker": "",
  "jp": "赤屍:楽しい仕事があれば\nいつでもご一緒しますよ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8DC2C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:楽しい仕事ね…\nそれってつまり危険なってことでしょ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8DCD4:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:今回は二人一緒に\nなることが多かったですね?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8DD74:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:…なによ、\nなんか不満でもあるワケ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8DE0C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:いえ…別にそういうわけでは…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8DE98:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:っていうか、\n男のくせに胸まで隠すのヤメなさいよ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8DF3C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "花月:そういう卑弥呼さんは\nもう少し女らしくされた方が…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8DFE0:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:なによ、やるっていうの?\nいつでも相手になってやるわよ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E08C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:アンタって、一番\nマトモそうに見えてかなりヤバいわよね",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E134:0",
  "kind": "msg",
  "speaker": "",
  "jp": "士度:キグルミのことかよ?\nあれは笑師がムリヤリにだな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E1D8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:とか言いながらコントとか\n楽しんでやってんじゃないの?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E280:0",
  "kind": "msg",
  "speaker": "",
  "jp": "士度:楽しんでねーよ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E300:0",
  "kind": "msg",
  "speaker": "",
  "jp": "笑師:卑弥呼ちゃ~ん、\nワイと夫婦漫才せぇへん?",
  "en": "",
  "status": ""
 },
 {
  "id": "F8E39C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:絶対にやらないわ…\nというよりも、夫婦にならないわよ！！",
  "en": "",
  "status": ""
 }
]
