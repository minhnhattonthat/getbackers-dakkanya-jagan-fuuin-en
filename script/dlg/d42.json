 {
  "id": "F8AB28:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:んあ~、今回も色々あったね~",
  "en": "",
  "status": ""
 },
 {
  "id": "F8ABB4:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:羨木は追いかけてくるわ、\n赤屍は出てくるわで大変だったな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8AC5C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:あっ、そういえば蛮ちゃんに\nそっくりなヘビがいたよね~！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8AD04:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:臨海パークじゃ、\nアイドル衣装で歌も歌っちまったしな",
  "en": "",
  "status": ""
 },
 {
  "id": "F8ADA8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:神門の里では\n露天風呂にも入っちゃったしね！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8AE48:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:色々あったな…でも、\nやっぱり金は手に入らねえんだよな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8AEF0:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:がんばって\n借金返そうね、蛮ちゃん！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F8AF88:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:ったく、お前は今回も\n俺様に頼りっぱなしだったよな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B02C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:それはこっちのセリフよ！\n催眠香がないと先に進めなかったくせに",
  "en": "",
  "status": ""
 },
 {
  "id": "F8B0DC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:ンなこと言ってていいのかねえ…",
  "en": "",
  "status": ""
 }
