 {
  "id": "F8AB28:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:んあ~、今回も色々あったね~",
  "en": "Ginji: Uhh, a whole lot happened this time too~",
  "status": "tl"
 },
 {
  "id": "F8ABB4:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:羨木は追いかけてくるわ、\n赤屍は出てくるわで大変だったな…",
  "en": "Ban: Hishiki chasin' after us, Akabane showin' up... What a hassle that was...",
  "status": "tl"
 },
 {
  "id": "F8AC5C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:あっ、そういえば蛮ちゃんに\nそっくりなヘビがいたよね~！",
  "en": "Ginji: Oh, that reminds me, there was a snake that looked just like you, Ban~!",
  "status": "tl"
 },
 {
  "id": "F8AD04:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:臨海パークじゃ、\nアイドル衣装で歌も歌っちまったしな",
  "en": "Ban: And at Seaside Park, I even ended up singin' in an idol costume.",
  "status": "tl"
 },
 {
  "id": "F8ADA8:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:神門の里では\n露天風呂にも入っちゃったしね！",
  "en": "Ginji: And at Mikado Village, we got to soak in an open-air bath!",
  "status": "tl"
 },
 {
  "id": "F8AE48:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:色々あったな…でも、\nやっぱり金は手に入らねえんだよな…",
  "en": "Ban: Lotta stuff happened... But we still never get our hands on any money...",
  "status": "tl"
 },
 {
  "id": "F8AEF0:0",
  "kind": "msg",
  "speaker": "",
  "jp": "銀次:がんばって\n借金返そうね、蛮ちゃん！！",
  "en": "Ginji: Let's do our best and pay off our debt, Ban!!",
  "status": "tl"
 },
 {
  "id": "F8AF88:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:ったく、お前は今回も\n俺様に頼りっぱなしだったよな…",
  "en": "Ban: Jeez, you were leaning on the great Ban the whole time again, weren'tcha...",
  "status": "tl"
 },
 {
  "id": "F8B02C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "卑弥呼:それはこっちのセリフよ！\n催眠香がないと先に進めなかったくせに",
  "en": "Himiko: That's my line! You couldn't have gone on without the Hypno Incense!",
  "status": "tl"
 },
 {
  "id": "F8B0DC:0",
  "kind": "msg",
  "speaker": "",
  "jp": "蛮:ンなこと言ってていいのかねえ…",
  "en": "Ban: Ya sure you wanna be talkin' like that...?",
  "status": "tl"
 }
]
