 {
  "id": "F70D58:3",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "あのオヤジも\n利用されてただけってことだろうよ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F70D58:4",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "さて、さっさとクレイマンとこに\n持ってってやるとするか！",
  "en": "",
  "status": ""
 },
 {
  "id": "F70E50:1",
  "kind": "msg",
  "speaker": "忍者A",
  "jp": "オイ、聞いたか\nこの屋敷、即日解体されるらしいぞ",
  "en": "",
  "status": ""
 },
 {
  "id": "F70E50:3",
  "kind": "msg",
  "speaker": "忍者B",
  "jp": "そうなったら俺たちはどうなるんだ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F70E50:5",
  "kind": "msg",
  "speaker": "忍者A",
  "jp": "…リストラされるんじゃないか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F70E50:7",
  "kind": "msg",
  "speaker": "忍者B",
  "jp": "ヤバいな、再就職先探さないとな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F70E50:8",
  "kind": "msg",
  "speaker": "忍者B",
  "jp": "つっても、\n忍者の再就職先ってあるのか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F70FC8:1",
  "kind": "msg",
  "speaker": "忍者A",
  "jp": "聞いたか、先代が集めた美術品の\n盗品を処分しろという命令が出てるぞ",
  "en": "",
  "status": ""
 },
 {
  "id": "F70FC8:2",
  "kind": "msg",
  "speaker": "忍者A",
  "jp": "それでまずは左側の\n倉庫から片付けを始めるらしい",
  "en": "",
  "status": ""
 },
 {
  "id": "F70FC8:4",
  "kind": "msg",
  "speaker": "忍者B",
  "jp": "やれやれ…屋敷の解体が\n決まったせいで身辺整理に慌しいな",
  "en": "",
  "status": ""
 },
 {
  "id": "F70FC8:6",
  "kind": "msg",
  "speaker": "忍者A",
  "jp": "お前、\nちょっと先に行って見てこいよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F70FC8:8",
  "kind": "msg",
  "speaker": "忍者B",
  "jp": "オレが?\nでもカギを持ってないぞ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F70FC8:10",
  "kind": "msg",
  "speaker": "忍者A",
  "jp": "カギなら右の倉庫に置いてあったはずだ",
  "en": "",
  "status": ""
 },
 {
  "id": "F70FC8:12",
  "kind": "msg",
  "speaker": "忍者B",
  "jp": "ふう…やれやれだな",
  "en": "",
  "status": ""
 },
 {
  "id": "F71200:1",
  "kind": "msg",
  "speaker": "花月",
  "jp": "カギは以前、京介さんたちと\n戦った倉庫の中にあるようですね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F71200:2",
  "kind": "msg",
  "speaker": "花月",
  "jp": "行ってみましょう！",
  "en": "",
  "status": ""
 }
]
