[
 {
  "id": "F1AC90:0",
  "kind": "msg",
  "speaker": "",
  "jp": "RRRRRRRRR\nRRRRRRRRR…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1AC90:2",
  "kind": "msg",
  "speaker": "士度",
  "jp": "ん?　蛭田からか…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1AC90:4",
  "kind": "msg",
  "speaker": "蛭田",
  "jp": "ヤ、ヤバいぞ、奪還屋！\nパパが…パパがァァ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1AC90:6",
  "kind": "msg",
  "speaker": "士度",
  "jp": "オイ、落ち着けって\nで、なにがあったってんだ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1AC90:8",
  "kind": "msg",
  "speaker": "蛭田",
  "jp": "ヤツら交渉が決裂したから\nビルを爆破するって言ってんだよ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1AC90:9",
  "kind": "msg",
  "speaker": "蛭田",
  "jp": "これが落ち着いていられるか！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1AC90:11",
  "kind": "msg",
  "speaker": "士度",
  "jp": "そのパパがいなくなったら、お前が\nグループを背負って立つんだろうが?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1AC90:12",
  "kind": "msg",
  "speaker": "士度",
  "jp": "こんなモンでうろたえてんじゃねえ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1AC90:14",
  "kind": "msg",
  "speaker": "蛭田",
  "jp": "………",
  "en": "",
  "status": ""
 },
 {
  "id": "F1AC90:16",
  "kind": "msg",
  "speaker": "士度",
  "jp": "安心しろって、テメーの父親は\n俺たちが必ず奪還してやるからよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F1AC90:18",
  "kind": "msg",
  "speaker": "蛭田",
  "jp": "…頼んだぞ、奪還屋",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B084:1",
  "kind": "msg",
  "speaker": "士度",
  "jp": "マズいな…ビルを\n爆破するとか言ってるらしいぞ",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B084:3",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "だったら協力した方がよくない?\n時間ないんだしさ",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B084:5",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "しゃーねぇな…\n足引っ張ンじゃねーぞ、猿マワシ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B084:7",
  "kind": "msg",
  "speaker": "士度",
  "jp": "それはこっちのセリフだ！　ウニ頭！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:1",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "な、なんやアレ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:3",
  "kind": "msg",
  "speaker": "士度",
  "jp": "そういや蛭田が自分の姿を模した\nロボットを作らせてるとか言ってたな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:5",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "ロボットかいな！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:6",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "エエなあ…ああいうの\nワイらの分も作ってくれへんかな",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:7",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "メカ笑師の楼蘭舞踏籠とか\nめっさスゴそうやん",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:8",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "メカ士度はんの百獣擬態は…\nアカンかも知れへんな",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:10",
  "kind": "msg",
  "speaker": "士度",
  "jp": "なにがいけねぇんだよ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:12",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "メカ士度はんがニャーとか\n言うの聞きたないやん",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:14",
  "kind": "msg",
  "speaker": "士度",
  "jp": "別に普段から言ってねぇだろうが！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:16",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "またまたぁ！　マドカはんの\n前やと言うてるんちゃいますかぁ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:17",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "ホンマやらしぃなあ、士度はんはぁ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:19",
  "kind": "msg",
  "speaker": "士度",
  "jp": "言ってねえよ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:21",
  "kind": "msg",
  "speaker": "メカ蛭田",
  "jp": "…ガガガ…ピー…侵入者確認…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:23",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "アカンて、士度はん！\n漫才しとる場合ちゃいまっせ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B2C0:25",
  "kind": "msg",
  "speaker": "士度",
  "jp": "してねぇよ！\nクソッ、行くぞ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B804:1",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "ロボットゆうのも大したことあらへんな",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B804:2",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "こんなんやったら士度はんと\n漫才しながらでも余裕やな！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B804:3",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "ああっ！　どつき攻撃とか\nどないやろか、士度はん！?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B804:5",
  "kind": "msg",
  "speaker": "士度",
  "jp": "…勝手にやってろ",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B91C:1",
  "kind": "msg",
  "speaker": "士度",
  "jp": "待て、笑師\nその床…なにかありそうだぞ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B91C:3",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "なんや、心配性でんな~、士度はんは",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B91C:4",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "こんなん平気やてー…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B9E4:1",
  "kind": "msg",
  "speaker": "士度",
  "jp": "だから言っただろうが！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B9E4:3",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "す、す、す、すんまへ~ん…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B9E4:4",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "でも、これであの床が\n重量を感知することが分かったやんか",
  "en": "",
  "status": ""
 },
 {
  "id": "F1B9E4:6",
  "kind": "msg",
  "speaker": "士度",
  "jp": "つまり、あの床に重量をかけることなく\n扉の前まで移動できればいいってコトか",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BB24:1",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "笑師春樹、飛びまっせー！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BB24:2",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "士度はーん、\nワイの華麗なる晴れ姿見たってーや！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BBB4:1",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "アカン…着地失敗や………",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BBB4:3",
  "kind": "msg",
  "speaker": "士度",
  "jp": "(限りなく予想通りだな………)",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BC44:1",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "楽勝、楽勝~！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BC44:2",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "さ~て、バンバン行きまっせ~",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BC44:4",
  "kind": "msg",
  "speaker": "士度",
  "jp": "待て、笑師！\nその先には赤外線センサーがあるぞ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BC44:6",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "あ、危なっ！\nもうちょいではみ出すトコやったわ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BC44:7",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "赤外線かあ…どないしたらエエんやろ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BC44:9",
  "kind": "msg",
  "speaker": "士度",
  "jp": "そういえば赤外線を\n感知することのできる動物がいたな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BC44:11",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "おっ、ならそれ連れてきたらエエやん！\nその動物ってなんなん?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BC44:13",
  "kind": "msg",
  "speaker": "士度",
  "jp": "…ヘビだ",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BC44:15",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "なら頼みに行ってみよか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BEA8:1",
  "kind": "msg",
  "speaker": "バン",
  "jp": "よし、ちょっくら行ってくるぜ",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BEFC:1",
  "kind": "msg",
  "speaker": "士度",
  "jp": "腹減ってるとこを悪かったな",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BEFC:3",
  "kind": "msg",
  "speaker": "バン",
  "jp": "なァに、こんくれェ造作もねぇさ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1BEFC:4",
  "kind": "msg",
  "speaker": "バン",
  "jp": "じゃあな！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:1",
  "kind": "msg",
  "speaker": "士度",
  "jp": "おい、持って来たぜ",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:3",
  "kind": "msg",
  "speaker": "バン",
  "jp": "遅ェんだよ！\n俺様を餓死させる気かよ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:5",
  "kind": "msg",
  "speaker": "士度",
  "jp": "(餓死しちまえばよかったのにな…)",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:7",
  "kind": "msg",
  "speaker": "バン",
  "jp": "テメー…\n今、変なこと考えただろうが?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:9",
  "kind": "msg",
  "speaker": "士度",
  "jp": "いや、別に…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:10",
  "kind": "msg",
  "speaker": "士度",
  "jp": "ところで食べる前に\n赤外線を抜けてくれるんだろうな?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:12",
  "kind": "msg",
  "speaker": "バン",
  "jp": "あ?　ンなモンは\n俺様が卵を消化した後にしてくれや",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:14",
  "kind": "msg",
  "speaker": "士度",
  "jp": "時間がねぇんだよ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:16",
  "kind": "msg",
  "speaker": "バン",
  "jp": "ったく、しゃーねえな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:17",
  "kind": "msg",
  "speaker": "バン",
  "jp": "ンじゃま、\n俺様をそこまで連れてってくれや",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:19",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "士度、話はついたの?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:21",
  "kind": "msg",
  "speaker": "士度",
  "jp": "…まァな",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:23",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "わっ、なにこのヘビ！\n蛮ちゃんにそっくりだ~！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:25",
  "kind": "msg",
  "speaker": "卑弥呼",
  "jp": "ホント…憎たらしいとこがそっくりね",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:27",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ああ?　どこが似てんだよ！?\nこンなヤツと一緒にすンじゃねえ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:29",
  "kind": "msg",
  "speaker": "バン",
  "jp": "(そいつぁ俺様のセリフだ！！)",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C014:31",
  "kind": "msg",
  "speaker": "士度",
  "jp": "(同属嫌悪ってヤツだな…)",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C64C:1",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "なんだろ、これ?\nボタンが二つあるよ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C64C:3",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "タイミング合わせて二つのボタン\n押せってんじゃねーの?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C64C:5",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "じゃあ、呼吸合わせないとダメだね",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C748:1",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "おっしゃあ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C748:2",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "やっぱ俺ら、最強コンビだな！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C7BC:1",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "あれ?　なんか落ちてるよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C7BC:2",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "IDパス3をゲット！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C844:1",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ん、失敗したみてぇだな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C844:2",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "俺達は相性が悪ィってことか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:1",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "…っつーか、\nこん中から一匹探すんかいな！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:2",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "難儀やな~",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:4",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "おい、猿マワシ…\nどうにかしろや",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:6",
  "kind": "msg",
  "speaker": "士度",
  "jp": "アイツらは危険を\n寮知して興奮してんだ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:7",
  "kind": "msg",
  "speaker": "士度",
  "jp": "この状態じゃ、どうもなんねーよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:9",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "なンだ、そりゃ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:10",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ケモノに相手にされねーようじゃ\nテメーは用なしだ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:11",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "山へ帰れ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:13",
  "kind": "msg",
  "speaker": "士度",
  "jp": "うるせえ！\nテメーこそ海に帰れ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:15",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "ま、まあまあ二人とも…",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:16",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "で、結局どうすればいいの?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:18",
  "kind": "msg",
  "speaker": "士度",
  "jp": "この状態じゃ、一匹ずつ捕まえて\n調べてみるしかなさそうだな?",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:20",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "他のとちょっと違う感じの\nハムスターだよね！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1C8BC:21",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "探してみよう！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F1CBF4:1",
  "kind": "msg",
  "speaker": "士度",
