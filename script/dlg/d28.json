  "status": ""
 },
 {
  "id": "F529EC:11",
  "kind": "msg",
  "speaker": "花月",
  "jp": "ゆえに通常の何倍もの力が\n出せるというわけだ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F529EC:13",
  "kind": "msg",
  "speaker": "雨流",
