  "status": ""
 },
 {
  "id": "F53A5C:12",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "(よ、良かった~…赤屍さんと\n二人っきりっていうのも怖いしね~…)",
  "en": "",
  "status": ""
 },
 {
  "id": "F53CEC:1",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "うわっ、ワープした！?",
  "en": "",
  "status": ""
 },
 {
