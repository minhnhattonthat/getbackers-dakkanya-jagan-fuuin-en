  "status": ""
 },
 {
  "id": "F52F90:7",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ったく、\nあのヤロー…どこ行きやがったンだ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F52F90:9",
  "kind": "msg",
  "speaker": "花月",
  "jp": "どうかしたんですか、美堂クン",
  "en": "",
  "status": ""
 },
 {
  "id": "F52F90:10",
  "kind": "msg",
  "speaker": "花月",
  "jp": "銀次さんなら必ずこの場所に汕り着く…\nあなたもそう信じているはずです",
  "en": "",
  "status": ""
 },
 {
  "id": "F52F90:11",
  "kind": "msg",
  "speaker": "花月",
  "jp": "なにをそんなに心配してるんですか?",
