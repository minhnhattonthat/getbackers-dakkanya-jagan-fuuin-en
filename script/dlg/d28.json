  "status": ""
 },
 {
  "id": "F5342C:23",
  "kind": "msg",
  "speaker": "赤屍",
  "jp": "そうですか?　残念ですね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F5342C:24",
  "kind": "msg",
  "speaker": "赤屍",
