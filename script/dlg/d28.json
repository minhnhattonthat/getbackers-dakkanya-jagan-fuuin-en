  "status": ""
 },
 {
  "id": "F52F90:13",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "別に………",
  "en": "",
  "status": ""
 },
 {
  "id": "F52F90:14",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "(ヤベェ気配がお前に近づいてる…\n油断するんじゃねーぞ、銀次！！)",
