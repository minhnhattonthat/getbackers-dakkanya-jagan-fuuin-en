  "en": "",
  "status": ""
 },
 {
  "id": "F57A18:17",
  "kind": "msg",
  "speaker": "士度",
  "jp": "俺は別に…",
  "en": "",
  "status": ""
 },
 {
  "id": "F57A18:19",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "エエやん、エエやん！\nたまには休息も必要でっせ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F57A18:21",
  "kind": "msg",
  "speaker": "雨流",
  "jp": "俺たちはどうする?",
  "en": "",
  "status": ""
 },
 {
  "id": "F57A18:23",
  "kind": "msg",
  "speaker": "花月",
  "jp": "そうだね…入っておこうか",
  "en": "",
  "status": ""
 },
 {
  "id": "F57A18:25",
  "kind": "msg",
  "speaker": "十兵衛",
  "jp": "いいのか、そんなことをしていて?",
  "en": "",
  "status": ""
 },
 {
  "id": "F57A18:27",
  "kind": "msg",
  "speaker": "花月",
  "jp": "疲れはとれる時にとっておくと\nいうことも大事なことだからね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:1",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "ねえねえ、\n卑弥呼ちゃんは入らないの~?",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:3",
  "kind": "msg",
  "speaker": "卑弥呼",
  "jp": "ちょっと、なに言ってんのよ！\n入るわけないじゃない！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:5",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "貧乳だから\n入りたくても入れねえってか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:7",
  "kind": "msg",
  "speaker": "卑弥呼",
  "jp": "…覚えてなさいよ、蛮",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:9",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "なんや~、\n卑弥呼ちゃんも入ったらエエのにぃ",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:10",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "女の子と温泉なんて最高や~ん",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:12",
  "kind": "msg",
  "speaker": "士度",
  "jp": "…そうか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:14",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "士度はんもマドカちゃん\n誘って温泉いったらええやんか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:16",
  "kind": "msg",
  "speaker": "士度",
  "jp": "興味ねーよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:18",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "はっ、まさかいっつも混浴なんか！?\nホンマやらしぃなあ、士度はんはぁ",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:20",
  "kind": "msg",
  "speaker": "士度",
  "jp": "してねーっつーの！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:22",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "いつも嬢ちゃんと混浴だァ?\nチッ、生意気な…",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:24",
  "kind": "msg",
  "speaker": "士度",
  "jp": "だから、\nしてねーって言ってんだろうが！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:26",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "いいなあ、士度…",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:27",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "ところでさ、\nあっちはあっちで混浴っぽいんだけど",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:29",
  "kind": "msg",
  "speaker": "花月",
  "jp": "?　僕たちがですか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:31",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "確かに…\nやけに女っぽく見えるヤツがいるからな",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:33",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "カヅっちゃんって、そういう教育を\n受けてるせいかすっごく女っぽいしね~",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:35",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "むしろ本物の女の子やったらエエのにぃ",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:37",
  "kind": "msg",
  "speaker": "花月",
  "jp": "そういわれても…",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:39",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "サムライ君たちはそれでいいのかよ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:40",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "チームのリーダーっつったら\n筋肉バリバリの方がいーんじゃねえの?",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:42",
  "kind": "msg",
  "speaker": "十兵衛",
  "jp": "人を見かけだけで判断するな",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:43",
  "kind": "msg",
  "speaker": "十兵衛",
  "jp": "花月にはチームを率いる\nリーダーとしての才覚がある",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:45",
  "kind": "msg",
  "speaker": "雨流",
  "jp": "そういうことだ",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:46",
  "kind": "msg",
  "speaker": "雨流",
  "jp": "俺たちは花月の\nその才能に惹かれ、集ったのだ",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:48",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "そういうワリにはオメーら二人共\n絃巻きを裏切ってなかったかよ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:51",
  "kind": "msg",
  "speaker": "雨流",
  "jp": "！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:53",
  "kind": "msg",
  "speaker": "雨流",
  "jp": "………",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:55",
  "kind": "msg",
  "speaker": "十兵衛",
  "jp": "………",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:57",
  "kind": "msg",
  "speaker": "花月",
  "jp": "い、いいんだよ、二人とも…\n僕は別に気にしてないから…",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:60",
  "kind": "msg",
  "speaker": "雨流",
  "jp": "スマン…花月",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:62",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "カヅっちゃんが風雅を解散させたことに\nスネてただけなんだろうね~、きっと",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:64",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ああ見えて子供っぽいっつーか、\nなんつーか…",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:66",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "…あっ、そういえば\n赤屍さんは温泉入らないんですか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:68",
  "kind": "msg",
  "speaker": "赤屍",
  "jp": "ええ、遠慮させていただきます",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:69",
  "kind": "msg",
  "speaker": "赤屍",
  "jp": "ですが、あなたがどうしてもと\nおっしゃるのであれば入りますが…",
  "en": "",
  "status": ""
 },
 {
  "id": "F57F94:71",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "いえ、別に…\nムリして入ることないと思いますよ…",
  "en": "",
  "status": ""
 }
]
