 },
 {
  "id": "F52354:3",
  "kind": "msg",
  "speaker": "雨流",
  "jp": "しかもここに来て分かれ道だ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F52354:4",
  "kind": "msg",
  "speaker": "雨流",
  "jp": "この中から正解の道を\n探すというのも難しい話だな",
