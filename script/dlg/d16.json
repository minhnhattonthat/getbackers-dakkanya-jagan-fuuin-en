  "status": ""
 },
 {
  "id": "F2A370:10",
  "kind": "msg",
  "speaker": "卑弥呼",
  "jp": "あたしもパス\n付き合ってらんないわよ、あんなの",
  "en": "",
  "status": ""
 }
