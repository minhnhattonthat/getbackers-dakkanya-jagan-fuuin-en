  "status": ""
 },
 {
  "id": "F29A70:27",
  "kind": "msg",
  "speaker": "笑師",
  "jp": "せや！\n他ならぬMAIちゃんの頼みや！",
  "en": "",
  "status": ""
 },
 {
  "id": "F29A70:28",
  "kind": "msg",
  "speaker": "笑師",
