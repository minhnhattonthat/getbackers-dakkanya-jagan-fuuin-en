  "status": ""
 },
 {
  "id": "F29A70:34",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "おう、つけてやろーじゃねえかよ！\n奪還で勝負だ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F29A70:36",
  "kind": "msg",
  "speaker": "士度",
  "jp": "面白ェ、返り討ちにしてやるぜ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F29A70:38",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "後で吠え面かくなよ、薇マワシ！",
