  "status": ""
 },
 {
  "id": "F28B48:3",
  "kind": "msg",
  "speaker": "杏",
  "jp": "いやッス！　杏はここに残るッス！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:5",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ああン?　テメー、まだ取材が\nどうのと言ってンじゃねえだろうな?",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:6",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ンな遊びみてェなこと\nしてる場合じゃねーんだぞ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:8",
  "kind": "msg",
  "speaker": "杏",
  "jp": "遊びじゃないッス！",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:9",
  "kind": "msg",
  "speaker": "杏",
  "jp": "杏にはどうしても\n調べなきゃならないことがあるんスよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:11",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "調べなきゃならないことって?",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:13",
  "kind": "msg",
  "speaker": "杏",
  "jp": "そりゃモチロン、パパの行方ッス！",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:14",
  "kind": "msg",
  "speaker": "杏",
  "jp": "今は行方不明だけど…きっとどこかで\n生きてるって杏は信じてるッス！",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:16",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "…で、テメーの父親が\nこの事件と関わってるってのか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:18",
  "kind": "msg",
  "speaker": "杏",
  "jp": "パパはある日、大きな仕事があるって\n出かけたまま帰って来なかったッス",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:19",
  "kind": "msg",
  "speaker": "杏",
  "jp": "パパの残した手がかりは\nこのカメラと手帳…それだけだったッス",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:20",
  "kind": "msg",
  "speaker": "杏",
  "jp": "手帳のパパがいなくなった日付の欄には\n15時にKと会う予定と書かれてたッス",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:22",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "…K?",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:24",
  "kind": "msg",
  "speaker": "杏",
  "jp": "そッス！\n杏はKを探して東京に来たッス",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:25",
  "kind": "msg",
  "speaker": "杏",
  "jp": "Kに会えばパパの行方が\n掴めるかも知れないって思ったッス",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:26",
  "kind": "msg",
  "speaker": "杏",
  "jp": "そしてこの前、\nやっと一つだけ手がかりを掴んだッス！",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:28",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "一つ掴んだ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:30",
  "kind": "msg",
  "speaker": "杏",
  "jp": "それがこれ…\n窪ちんの日記の1ページッス",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:32",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "それをなんで杏ちゃんが持ってるの?",
