  "status": ""
 },
 {
  "id": "F29A70:30",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "テメーら…\n今日という今日は許さねえぞ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F29A70:32",
  "kind": "msg",
  "speaker": "士度",
  "jp": "なんだよ、決着つけるってのか?",
