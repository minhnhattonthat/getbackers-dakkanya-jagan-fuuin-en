  "id": "F2A370:6",
  "kind": "msg",
  "speaker": "ヘヴン",
  "jp": "今回は一応、\nみんなでってことになってるけど?",
  "en": "",
  "status": ""
 },
 {
  "id": "F2A370:8",
  "kind": "msg",
  "speaker": "花月",
  "jp": "パスしますよ\n僕が行かなくても大丈夫でしょうし…",
