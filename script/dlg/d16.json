  "status": ""
 },
 {
  "id": "F2A274:4",
  "kind": "msg",
  "speaker": "マネージャー",
  "jp": "それではくれぐれもお願いします…",
  "en": "",
  "status": ""
 },
 {
  "id": "F2A370:1",
  "kind": "msg",
  "speaker": "卑弥呼",
  "jp": "バカね、アイツら…協力すればいいのに",
  "en": "",
  "status": ""
 },
 {
  "id": "F2A370:3",
  "kind": "msg",
  "speaker": "花月",
  "jp": "ええ…そうですね………",
  "en": "",
  "status": ""
 },
 {
  "id": "F2A370:5",
  "kind": "msg",
  "speaker": "ヘヴン",
  "jp": "で、アナタたちはどうするの?",
