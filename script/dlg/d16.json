 {
  "id": "F29A70:19",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "グハッ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F29A70:21",
  "kind": "msg",
  "speaker": "花月",
  "jp": "…20億ですか…すごいですね",
  "en": "",
  "status": ""
 },
 {
  "id": "F29A70:23",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "んあ~、借金地嶽~………",
