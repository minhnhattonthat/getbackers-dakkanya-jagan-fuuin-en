  "id": "F28B48:65",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "いいか、危なくなったらすぐに逃げろ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:66",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "こっちはテメーに\n構ってるヒマなんぞねぇんだからな",
  "en": "",
  "status": ""
 },
 {
  "id": "F28B48:68",
  "kind": "msg",
  "speaker": "杏",
  "jp": "じゃ、OKッスか?",
