  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:1",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "あれ、杏ちゃん\nこんなところでなにしてんの?",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:3",
  "kind": "msg",
  "speaker": "杏",
  "jp": "言ったじゃないッスか、取材だって！",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:4",
  "kind": "msg",
  "speaker": "杏",
  "jp": "杏、お二人の行くところを\nどこまでも追いかけて取材するッスよ~",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:6",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "テメーみてぇのが\nチョロチョロすっと危ねえだろうが！",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:7",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "帰れ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:9",
  "kind": "msg",
  "speaker": "杏",
  "jp": "大丈夫ッス！　杏、足には自信あるから\n敵には捕まらないッスよ~",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:10",
  "kind": "msg",
  "speaker": "杏",
  "jp": "あ、ここらで記念写真でも\nいかがッスか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:12",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "記念写真?",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:14",
  "kind": "msg",
  "speaker": "杏",
  "jp": "前にも言ったように、\nこのカメラには不思濤なモノが写るッス",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:15",
  "kind": "msg",
  "speaker": "杏",
  "jp": "写真を撮った人と一番仲がいい人が\nとなりに写ったりするッスよ~",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:16",
  "kind": "msg",
  "speaker": "杏",
  "jp": "でも仲が良くないと\nなにも撮れなかったりするんスけどね",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:18",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "う~ん、そんなカメラが\n前にもあったような…",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:20",
  "kind": "msg",
  "speaker": "杏",
  "jp": "他の写真も撮らなきゃならないんで\nここでは一回だけ撮ってあげるッス！",
  "en": "",
  "status": ""
 },
 {
  "id": "F051A8:21",
  "kind": "msg",
  "speaker": "杏",
  "jp": "一番前の人を撮るから、準備できたら\n話し掛けて欲しいッス！",
  "en": "",
  "status": ""
 },
 {
  "id": "F05658:1",
  "kind": "msg",
  "speaker": "杏",
  "jp": "さーて、取材がんばるッスよ~",
  "en": "",
  "status": ""
 },
 {
  "id": "F056AC:1",
  "kind": "choice",
  "speaker": "波児",
  "jp": "ブルマンをくれ",
  "en": "",
  "status": ""
 },
 {
  "id": "F056AC:2",
