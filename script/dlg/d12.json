  "status": ""
 },
 {
  "id": "F1706C:5",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "バケモンが…\nニトロブーストで振り切ってやる！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F17170:1",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ムハハハハ！\n見たか、俺様のドライブテクニック！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F17170:2",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "こうなりゃ、ミスターノーブレーキと\nいえど逃げられまい！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F17170:4",
  "kind": "msg",
  "speaker": "銀次",
