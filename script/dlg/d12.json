 },
 {
  "id": "F172AC:2",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "…馬車のオヤジめ、\nこの美堂蛮様をなめんなああああ~！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F172AC:4",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "蛮ちゃん、羨木竜童がっ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F172AC:6",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ついでにバケモンにも消えてもらうぜ！\nしっかり掴まってろよ、テメーら！！",
