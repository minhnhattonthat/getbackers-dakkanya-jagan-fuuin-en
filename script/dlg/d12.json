 {
  "id": "F16268:1",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "ねえ、蛮ちゃん\nお金ないから引き受けちゃったけど、",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:2",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "今度の依頼人さんって信頼できるの?",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:4",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "神門大介か…\nま、ちっとばかし怪しい気もすンけどな",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:5",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "にしたって今回の報酬は小判だぜ?\n受けるっきゃねーだろ！　ブハハハハ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:7",
  "kind": "msg",
  "speaker": "卑弥呼",
  "jp": "…ずいぶんと気楽なモンね",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:9",
  "kind": "msg",
  "speaker": "花月",
  "jp": "神門…\nそれは能楽の神門家のことですか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:11",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "知ってるの、カヅっちゃん?",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:13",
  "kind": "msg",
  "speaker": "花月",
  "jp": "ええ…能楽の一派ですが、\n一瞼には知られていないはずです",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:14",
  "kind": "msg",
  "speaker": "花月",
  "jp": "披らの能は時の権力者にだけ\n奉じられるものなんです",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:15",
  "kind": "msg",
  "speaker": "花月",
  "jp": "なんでもその舞で\n日本の歴史を動かしてきたとか…",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:17",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "えっ、舞でどうやって歴史を動かすの?",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:19",
  "kind": "msg",
  "speaker": "花月",
  "jp": "神門家は特別な能を舞う際、\n巫面(かんなぎめん)という",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:20",
  "kind": "msg",
  "speaker": "花月",
  "jp": "特殊な面をつけて舞うそうです",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:21",
  "kind": "msg",
  "speaker": "花月",
  "jp": "巫面には翁、神、男、女、狂、鬼の\n六種類があります",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:22",
  "kind": "msg",
  "speaker": "花月",
  "jp": "その六つの面は\nそれぞれ不思議な力を宿していたとか…",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:23",
  "kind": "msg",
  "speaker": "花月",
  "jp": "詳しいことは僕にも分かりませんが、\nそれをつけることで時の流れを",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:24",
  "kind": "msg",
  "speaker": "花月",
  "jp": "見通すことができたのではないかと\n思いますね",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:26",
  "kind": "msg",
  "speaker": "卑弥呼",
  "jp": "まるで祈禱呪術ね…魔女みたいだわ",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:28",
  "kind": "msg",
  "speaker": "花月",
  "jp": "呪術の部類に入ると思いますよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:29",
  "kind": "msg",
  "speaker": "花月",
  "jp": "それに僕らがこの前遭遇したのが\n巫面の一つ『翁』の面ではないかと…",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:32",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "なにいいいいいっ！?",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:34",
  "kind": "msg",
  "speaker": "花月",
  "jp": "ど、どうかしましたか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:36",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "真っ二つにしちまったじゃねえかよ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:37",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "その巫面とやら六つ全部無傷で\n奪還するってのが条件だっつーのに！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:39",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "んあ~、依頼料引かれるの決定だね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:41",
  "kind": "msg",
  "speaker": "花月",
  "jp": "でもそれ以外のものを\n無傷で奪還すればいいんですよね?",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:43",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "ん~、それも無傷で\n奪り還せるか怪しいけどね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:45",
  "kind": "msg",
  "speaker": "卑弥呼",
  "jp": "なによ、いつになく弱気じゃない?\nどうしたってワケ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:47",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "残りの面を運ぶヤツらが厄介なんだよ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F16268:49",
  "kind": "msg",
  "speaker": "卑弥呼",
  "jp": "それってまさか…",
  "en": "",
  "status": ""
 },
 {
  "id": "F16CF8:1",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "いやがったぜ！\n運び屋、ミスターノーブレーキがよ！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F16CF8:3",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "でもってあのトラックに\n一緒に乗っているのは多分…",
  "en": "",
  "status": ""
 },
 {
  "id": "F16CF8:5",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ジャッカルのヤローだ！\nよっしゃ、アクセル全開で突っ込むぞ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F16E20:1",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "操作説明だ\nよく聞いとけよ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F16E20:2",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "まず十字ボタンの上下で車体の移動だ",
  "en": "",
  "status": ""
 },
 {
  "id": "F16E20:3",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "車や岩に当たると減速しちまうからな…\n気を付けろよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F16E20:4",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "それと道路上の弁当箱を取ると\nてんとう虫が加速するぜ",
  "en": "",
  "status": ""
 },
 {
  "id": "F16E20:5",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "スピード上げねえと馬車のトラックに\n追いつけねえから、なるべく取れよな",
  "en": "",
  "status": ""
 },
 {
  "id": "F16E20:6",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "弁当の他には\nニトロ缶が落ちてることがあるぜ",
  "en": "",
  "status": ""
 },
 {
  "id": "F16E20:7",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "これを取るとAボタンで\nニトロブーストが使えるってワケだ",
  "en": "",
  "status": ""
 },
 {
  "id": "F16E20:8",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ブースト発動中は無敵になるから、\nこの間に差を詰めねえとな",
  "en": "",
  "status": ""
 },
 {
  "id": "F16E20:9",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "よし、行くぞ！！",
  "en": "All right, let's move!!",
  "status": "tl"
 },
 {
