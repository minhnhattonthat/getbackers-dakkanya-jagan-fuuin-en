  "status": ""
 },
 {
  "id": "F1A26C:45",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "気にすンな、\n聞いたとこで分かりゃしねーから",
  "en": "",
  "status": ""
 },
 {
  "id": "F1AC28:0",
