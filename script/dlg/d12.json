  "en": "",
  "status": ""
 },
 {
  "id": "F17170:6",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "そうだな、\nとりあえず上から飛び移って…",
  "en": "",
  "status": ""
 },
 {
  "id": "F172AC:1",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "スピンターンだと！?",
