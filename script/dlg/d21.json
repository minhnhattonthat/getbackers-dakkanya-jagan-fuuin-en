  "status": ""
 },
 {
  "id": "F413C8:12",
  "kind": "msg",
  "speaker": "マドカ",
  "jp": "うん、楽しみにしてるね",
  "en": "",
  "status": ""
 },
 {
  "id": "F413C8:14",
  "kind": "msg",
  "speaker": "MAI",
  "jp": "士度さん、マドカ…本当にありがとう",
  "en": "",
  "status": ""
 },
 {
  "id": "F413C8:15",
  "kind": "msg",
  "speaker": "MAI",
  "jp": "あなたたちがいなかったら、\n今の私はなかったわ",
  "en": "",
  "status": ""
 },
 {
  "id": "F413C8:17",
  "kind": "msg",
  "speaker": "士度",
  "jp": "俺たちはただきっかけを\n与えただけに過ぎねえさ…",
  "en": "",
  "status": ""
 },
 {
  "id": "F413C8:18",
  "kind": "msg",
  "speaker": "士度",
  "jp": "アンタが自分で変わったと思うなら\nそれはアンタ自身の力だ",
  "en": "",
  "status": ""
 },
 {
  "id": "F413C8:19",
  "kind": "msg",
  "speaker": "士度",
  "jp": "アンタはそれを信じていけばいい",
  "en": "",
  "status": ""
 },
 {
  "id": "F413C8:21",
  "kind": "msg",
  "speaker": "MAI",
  "jp": "…そうね",
  "en": "",
  "status": ""
 },
 {
  "id": "F413C8:22",
  "kind": "msg",
  "speaker": "MAI",
  "jp": "…さよなら\n士度さん、マドカ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F413C8:24",
  "kind": "msg",
  "speaker": "マドカ",
  "jp": "元気でね、MAI…",
  "en": "",
  "status": ""
 },
 {
  "id": "F418A0:1",
  "kind": "msg",
  "speaker": "士度",
  "jp": "…寂しくなるんじゃねえのか、マドカ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F418A0:3",
  "kind": "msg",
  "speaker": "マドカ",
  "jp": "大丈夫です",
  "en": "",
  "status": ""
 },
 {
  "id": "F418A0:4",
  "kind": "msg",
  "speaker": "マドカ",
  "jp": "MAIの歌を聴けば、いつでも\nMAIがそばにいるような気がするから",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:1",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "…じゃあ、京介さんは\n面に操られてるってこと?",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:3",
  "kind": "msg",
  "speaker": "花月",
  "jp": "ええ…僕が見た感じでは\nそういう印象を受けました",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:5",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ってことは面ヤローは\n黒幕じゃねえってことかよ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:7",
  "kind": "msg",
  "speaker": "花月",
  "jp": "ええ…Kと呼ばれる人物が\n背後についているみたいですが…",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:9",
  "kind": "msg",
  "speaker": "杏",
  "jp": "！！",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:11",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "えっ、\nそれって京介さんのことじゃないの?",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:13",
  "kind": "msg",
  "speaker": "花月",
  "jp": "詳しいことは分かりませんね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:14",
  "kind": "msg",
  "speaker": "花月",
  "jp": "それを調べるためにも敵に\n捕まってみたのですが、そこまでは…",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:16",
  "kind": "msg",
  "speaker": "杏",
  "jp": "………",
  "en": ".........",
  "status": "tl"
 },
 {
  "id": "F419C0:18",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "…しっかし、大介のヤツ遅ェなあ",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:19",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ちゃんと連絡したんだろうなあ、\nヘヴン?",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:21",
  "kind": "msg",
  "speaker": "ヘヴン",
  "jp": "したわよ！",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:22",
  "kind": "msg",
  "speaker": "ヘヴン",
  "jp": "大介クンたちもさっきまで\n臨海パーク付近にいたみたいよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:24",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "たち?",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:26",
  "kind": "msg",
  "speaker": "ヘヴン",
  "jp": "大介クンと…\nあのヒミコに関係した女のコね",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:28",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "それでヤツら、臨海パークにいる女を\n片っ端から誘拐したってワケか…",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:30",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "そのヒミコさんは\n捕まらなかったのかな?",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:32",
  "kind": "msg",
  "speaker": "ヘヴン",
  "jp": "臨海パークの手前で女のコの具合が\n悪くなったから、引き返したそうよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:34",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "都合のイイ話だな、オイ\n前から知ってたンじゃねーの?",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:36",
  "kind": "msg",
  "speaker": "花月",
  "jp": "京介さんと大介さんが\n裏で通じているという線ですか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:37",
  "kind": "msg",
  "speaker": "花月",
  "jp": "僕も調べてみたのですが、\nそれはなさそうですよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F419C0:38",
  "kind": "msg",
  "speaker": "花月",
  "jp": "今回のことは偶然だと思いますが…",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:1",
  "kind": "msg",
  "speaker": "大介",
  "jp": "申し訳ありません\n我々のせいでみなさんにご迷惑が…",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:3",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "いえいえ、これも仕事ですから\n(ツケもチャラになったし…)",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:4",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "あ、その人がヒミコさんですか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:6",
  "kind": "msg",
  "speaker": "瑠璃",
  "jp": "私の名は瑠璃と申します",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:8",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "あ、あれ?\nヒミコじゃないんだ???",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:10",
  "kind": "msg",
  "speaker": "瑠璃",
  "jp": "私は姫巫女(ひみこ)と\n呼ばれる巫女でもあります",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:12",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "へ~、巫女さんかあ",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:14",
  "kind": "msg",
  "speaker": "大介",
  "jp": "はい、\n瑠璃さんはとても霊力が強い巫女です",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:15",
  "kind": "msg",
  "speaker": "大介",
  "jp": "今回の事件もその力で事前に察知し、\n逃れることができたのですが…",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:16",
  "kind": "msg",
  "speaker": "大介",
  "jp": "その結果、\nこんなことになってしまいました",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:18",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "大介さんたちのせいじゃありませんよ",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:19",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "それに卑弥呼ちゃんも\nオレたちが必ず奪還するし…ね?",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:21",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "まァな…",
  "en": "Somethin' like that...",
  "status": "tl"
 },
 {
  "id": "F4220C:23",
  "kind": "msg",
  "speaker": "大介",
  "jp": "…では、みなさんには\n神門の里へ来ていただくことになります",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:25",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "神門の里だァ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:27",
  "kind": "msg",
  "speaker": "大介",
  "jp": "はい…僕と兄の生まれた場所です\n兄は必ずその場所に現れるはず…",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:28",
  "kind": "msg",
  "speaker": "大介",
  "jp": "みなさんには残りの巫面と\n卑弥呼さんの奪還をお願いします",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:30",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "行くでしょ、蛮ちゃん?",
  "en": "",
  "status": ""
 },
 {
  "id": "F4220C:32",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "あったりめーだ！\nこの依頼…確かに引き受けたぜ",
  "en": "",
  "status": ""
 },
 {
  "id": "F428D8:1",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "あれ~???\n変わらないね、水の量が…",
  "en": "",
  "status": ""
 },
 {
  "id": "F428D8:3",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "レバーを間違えたか…",
  "en": "",
  "status": ""
 },
 {
  "id": "F4296C:0",
  "kind": "msg",
  "speaker": "",
  "jp": "警報装置を解除した！",
  "en": "",
  "status": ""
 },
 {
  "id": "F429B0:1",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "トビラの下に小さな穴が開いてンな\n子供とかなら通れるかもな…",
  "en": "",
  "status": ""
 },
 {
  "id": "F42A28:1",
  "kind": "msg",
  "speaker": "ギャル",
  "jp": "助けてくれるんですか?\nありがとうございます",
  "en": "",
  "status": ""
 },
 {
  "id": "F42A28:3",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ところでアンタ…ここに女みてぇな男と\n男みてぇな女がいるの知らねえか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F42A28:5",
  "kind": "msg",
  "speaker": "ギャル",
  "jp": "女みたいな…?\nああ…いましたね、そんな人",
  "en": "",
  "status": ""
 },
 {
  "id": "F42A28:6",
  "kind": "msg",
  "speaker": "ギャル",
  "jp": "髪が長い人のことでしょ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F42A28:8",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "で、どこにいるか知ってるか?",
  "en": "",
  "status": ""
 },
 {
  "id": "F42A28:10",
  "kind": "msg",
  "speaker": "ギャル",
  "jp": "う~ん、\nもっと下の階に連れていかれたかも",
  "en": "",
  "status": ""
 },
 {
  "id": "F42A28:12",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "そっかあ…どうもありがと！",
  "en": "",
  "status": ""
 },
 {
  "id": "F42C3C:1",
  "kind": "msg",
  "speaker": "ギャル",
  "jp": "ありがとう、助けてくれるんですね?",
  "en": "",
  "status": ""
 },
 {
  "id": "F42C3C:3",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "ところでこの辺で神父みてぇな\nカッコしたヤツ見なかったかよ?",
  "en": "",
  "status": ""
 },
 {
  "id": "F42C3C:5",
  "kind": "msg",
  "speaker": "ギャル",
  "jp": "神父?　えーと、\nそれって白い服のことかしら?",
  "en": "",
  "status": ""
 },
 {
  "id": "F42C3C:7",
  "kind": "msg",
  "speaker": "蛮",
  "jp": "それだ、それだ",
  "en": "",
  "status": ""
 },
 {
  "id": "F42C3C:9",
  "kind": "msg",
  "speaker": "ギャル",
  "jp": "うーん…同じカッコした人が\n何人もいるみたいだけど…",
  "en": "",
  "status": ""
 },
 {
  "id": "F42C3C:10",
  "kind": "msg",
  "speaker": "ギャル",
  "jp": "なんなの、あの人たち?",
  "en": "",
  "status": ""
 },
 {
  "id": "F42C3C:12",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "なんなんでしょうね…",
  "en": "",
  "status": ""
 },
 {
  "id": "F42E34:1",
  "kind": "msg",
  "speaker": "ギャル",
  "jp": "助けてくれるの?　ありがとう！",
  "en": "",
  "status": ""
 },
 {
  "id": "F42E34:3",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "ところでここに何人くらいの\n女の人が捕まってるか分かります?",
  "en": "",
  "status": ""
 },
 {
  "id": "F42E34:5",
  "kind": "msg",
  "speaker": "ギャル",
  "jp": "え~、結構いるわよ?\n20人以上かな?",
  "en": "",
  "status": ""
 },
 {
  "id": "F42E34:7",
  "kind": "msg",
  "speaker": "銀次",
  "jp": "そ、そんなにいるんだ~…",
  "en": "",
  "status": ""
 },
 {
  "id": "F42F74:1",
  "kind": "msg",
  "speaker": "ギャル",
  "jp": "え、助けてくれるの?\n良かった~、ありがとうございます！",
  "en": "",
  "status": ""
 }
]
